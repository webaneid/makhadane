parameters:
	ignoreErrors:
		-
			message: '#^Filter callback return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: inc/custompost.php

		-
			message: '#^Action callback returns string but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: inc/makhadane.php

		-
			message: '#^Cannot assign offset ''image'' to string\.$#'
			identifier: offsetAssign.dimType
			count: 1
			path: inc/media.php

		-
			message: '#^Offset ''mime'' does not exist on string\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: inc/media.php

		-
			message: '#^Offset ''url'' does not exist on string\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: inc/media.php

		-
			message: '#^Access to an undefined property WP_Term\:\:\$cat_name\.$#'
			identifier: property.notFound
			count: 1
			path: inc/post.php

		-
			message: '#^Variable \$subjects in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: inc/seo.php

		-
			message: '#^Return type \(void\) of method Ane_Posts_Widget\:\:form\(\) should be compatible with return type \(string\|null\) of method WP_Widget\<array\<string, mixed\>\>\:\:form\(\)$#'
			identifier: method.childReturnType
			count: 1
			path: inc/widgets.php

		-
			message: '#^Access to an undefined property WP_Term\:\:\$cat_name\.$#'
			identifier: property.notFound
			count: 2
			path: single.php

		-
			message: '#^Access to an undefined property WP_Term\:\:\$cat_name\.$#'
			identifier: property.notFound
			count: 2
			path: tp/single.php

		-
			message: '#^Result of function ane_get_title \(void\) is used\.$#'
			identifier: function.void
			count: 1
			path: tp/single.php
